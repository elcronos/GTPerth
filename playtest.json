{
 "query": "autostart=1&q=low&dynres=0&mb=0",
 "w": 480,
 "h": 270,
 "steps": [
  {
   "waitFor": "__G.game && __G.game.state.mode === 'playing'",
   "timeout": 20000
  },
  {
   "assert": "__stats().modules.every(m => m.ok && !m.stub)",
   "msg": "every boot stage ok (no stubs)"
  },
  {
   "assert": "__G.game.mission.step === 'goto'",
   "msg": "mission starts: go to the jetty"
  },
  {
   "eval": "[__G.game.player.x, __G.game.player.z]",
   "as": "p0"
  },
  {
   "hold": "forward",
   "ms": 9000
  },
  {
   "assert": "Math.hypot(__G.game.player.x - __pt.p0[0], __G.game.player.z - __pt.p0[1]) > 0.25",
   "msg": "W walks the player"
  },
  {
   "press": "fire",
   "after": 300
  },
  {
   "assert": "__G.game.player.ch.punchT < 1 || __G.game.player.combat.combo > 0",
   "msg": "click punches"
  },
  {
   "eval": "(()=>{const G=__G,P=G.game.player,f=[Math.sin(P.yaw),Math.cos(P.yaw)];const q=G.game.peds.list.filter(q=>q.ch.state==='ok'&&q.kind!=='idle').sort((a,b)=>a.ch.root.position.distanceTo(P.ch.root.position)-b.ch.root.position.distanceTo(P.ch.root.position))[0];q.kind='idle';q.state='idle';q.gesture=null;q.idleYaw=P.yaw+Math.PI;q.ch.root.position.set(P.x+f[0]*1.3,P.y,P.z+f[1]*1.3);window.__pt.victim=q;return !!q})()"
  },
  {
   "press": "fire",
   "after": 700
  },
  {
   "press": "fire",
   "after": 700
  },
  {
   "waitFor": "(__pt.victim.hp??100) < 100 || __pt.victim.ch.state !== 'ok'",
   "timeout": 40000
  },
  {
   "assert": "(__pt.victim.hp??100) < 100 || __pt.victim.ch.state !== 'ok'",
   "msg": "punches connect with a pedestrian in front (damage or knock-down)"
  },
  {
   "eval": "(()=>{const P=__G.game.player;P.teleport(112,-170,0);return [P.x,P.z]})()"
  },
  {
   "move": [
    0,
    1
   ],
   "ms": 3500
  },
  {
   "assert": "!__G.game.player.swimming && !__G.game.player.groundAt?.water",
   "msg": "walking at the river edge does not drop the player into the water"
  },
  {
   "eval": "__G.game.teleport(14, -126)"
  },
  {
   "wait": 1500
  },
  {
   "press": "interact",
   "after": 1500
  },
  {
   "assert": "__G.game.player.vehicle === __G.game.ferry",
   "msg": "F at the jetty hijacks the ferry"
  },
  {
   "assert": "__G.game.wanted.stars >= 2",
   "msg": "stealing the ferry gives 2+ stars"
  },
  {
   "assert": "__G.game.mission.step === 'cross'",
   "msg": "objective: cross to Mends Street"
  },
  {
   "eval": "[__G.game.ferry.x, __G.game.ferry.z]",
   "as": "f0"
  },
  {
   "hold": "forward",
   "ms": 12000
  },
  {
   "assert": "Math.hypot(__G.game.ferry.x - __pt.f0[0], __G.game.ferry.z - __pt.f0[1]) > 0.15",
   "msg": "W drives the ferry"
  },
  {
   "shot": "ferry-driving"
  },
  {
   "eval": "__G.game.debugWin()"
  },
  {
   "wait": 3000
  },
  {
   "assert": "__G.game.mission.step === 'passed'",
   "msg": "berthing at Mends Street passes the mission (WIN)"
  },
  {
   "assert": "__G.game.hud.cash >= 50000",
   "msg": "reward paid"
  },
  {
   "shot": "mission-passed"
  },
  {
   "eval": "__G.game.debugLose()"
  },
  {
   "wait": 2500
  },
  {
   "assert": "__G.game.state.mode === 'dead'",
   "msg": "health 0 \u2192 WASTED (LOSE)"
  },
  {
   "shot": "wasted"
  },
  {
   "waitFor": "__G.game.state.mode === 'playing'",
   "timeout": 120000
  },
  {
   "assert": "__G.game.player.health === 100",
   "msg": "respawn restores health (restart)"
  },
  {
   "eval": "__G.game.debugBusted()"
  },
  {
   "wait": 1500
  },
  {
   "assert": "__G.game.state.mode === 'dead' && __G.game.state.kind === 'busted'",
   "msg": "BUSTED state"
  },
  {
   "waitFor": "__G.game.state.mode === 'playing'",
   "timeout": 120000
  },
  {
   "press": "pause",
   "after": 6000
  },
  {
   "assert": "__G.game.state.mode === 'paused'",
   "msg": "Esc pauses"
  },
  {
   "press": "pause",
   "after": 6000
  },
  {
   "assert": "__G.game.state.mode === 'playing'",
   "msg": "Esc resumes"
  }
 ]
}