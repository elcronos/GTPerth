{
 "query": "autostart=1&q=low&dynres=0&mb=0",
 "w": 480,
 "h": 270,
 "steps": [
  {
   "waitFor": "__G.game && __G.game.state.mode === 'playing'",
   "timeout": 20000
  },
  {
   "assert": "__stats().modules.every(m => m.ok && !m.stub)",
   "msg": "every boot stage ok (no stubs)"
  },
  {
   "assert": "__G.game.mission.step === 'goto'",
   "msg": "mission starts: go to the jetty"
  },
  {
   "eval": "[__G.game.player.x, __G.game.player.z]",
   "as": "p0"
  },
  {
   "hold": "forward",
   "ms": 9000
  },
  {
   "assert": "Math.hypot(__G.game.player.x - __pt.p0[0], __G.game.player.z - __pt.p0[1]) > 0.25",
   "msg": "W walks the player"
  },
  {
   "press": "fire",
   "after": 300
  },
  {
   "assert": "__G.game.player.ch.punchT > 0",
   "msg": "click punches"
  },
  {
   "eval": "__G.game.teleport(-55, -80)"
  },
  {
   "wait": 1500
  },
  {
   "press": "interact",
   "after": 1500
  },
  {
   "assert": "__G.game.player.vehicle === __G.game.ferry",
   "msg": "F at the jetty hijacks the ferry"
  },
  {
   "assert": "__G.game.wanted.stars >= 2",
   "msg": "stealing the ferry gives 2+ stars"
  },
  {
   "assert": "__G.game.mission.step === 'cross'",
   "msg": "objective: cross to Mends Street"
  },
  {
   "eval": "[__G.game.ferry.x, __G.game.ferry.z]",
   "as": "f0"
  },
  {
   "hold": "forward",
   "ms": 12000
  },
  {
   "assert": "Math.hypot(__G.game.ferry.x - __pt.f0[0], __G.game.ferry.z - __pt.f0[1]) > 0.15",
   "msg": "W drives the ferry"
  },
  {
   "shot": "ferry-driving"
  },
  {
   "eval": "__G.game.debugWin()"
  },
  {
   "wait": 3000
  },
  {
   "assert": "__G.game.mission.step === 'passed'",
   "msg": "berthing at Mends Street passes the mission (WIN)"
  },
  {
   "assert": "__G.game.hud.cash >= 50000",
   "msg": "reward paid"
  },
  {
   "shot": "mission-passed"
  },
  {
   "eval": "__G.game.debugLose()"
  },
  {
   "wait": 2500
  },
  {
   "assert": "__G.game.state.mode === 'dead'",
   "msg": "health 0 \u2192 WASTED (LOSE)"
  },
  {
   "shot": "wasted"
  },
  {
   "waitFor": "__G.game.state.mode === 'playing'",
   "timeout": 120000
  },
  {
   "assert": "__G.game.player.health === 100",
   "msg": "respawn restores health (restart)"
  },
  {
   "eval": "__G.game.debugBusted()"
  },
  {
   "wait": 1500
  },
  {
   "assert": "__G.game.state.mode === 'dead' && __G.game.state.kind === 'busted'",
   "msg": "BUSTED state"
  },
  {
   "waitFor": "__G.game.state.mode === 'playing'",
   "timeout": 120000
  },
  {
   "press": "pause",
   "after": 600
  },
  {
   "assert": "__G.game.state.mode === 'paused'",
   "msg": "Esc pauses"
  },
  {
   "press": "pause",
   "after": 600
  },
  {
   "assert": "__G.game.state.mode === 'playing'",
   "msg": "Esc resumes"
  }
 ]
}